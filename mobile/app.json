{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "jsEngine": "hermes",
    "icon": "./assets/app-icon/app-icon.png",
    "scheme": "expense-tracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app-icon/app-icon.png",
      "bundleIdentifier": "com.kenneacsteam.expensetracker"
    },
    "android": {
      "package": "com.kenneacsteam.expensetracker",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/app-icon/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-icon/app-icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5a04ea59-d86a-47e4-ad11-a0109055c226"
      }
    },
    "owner": "kenneacs-team"
  }
}
